# ===== Top-Record — Contoh Environment Variables =====
# Salin file ini menjadi .env dan sesuaikan nilainya.

# Database lokal (default): SQLite file
DATABASE_URL=file:./db/custom.db

# WAJIB di production deploy! Kunci untuk menandatangani cookie sesi.
# Generate dengan: openssl rand -hex 32
# SESSION_SECRET=ganti-dengan-string-acak-64-karakter

# ===== Deploy Netlify/Vercel + Turso (WAJIB untuk deploy online) =====
# Kalau TURSO_DATABASE_URL di-set, aplikasi otomatis memakai Turso (libSQL)
# sebagai database, dan DATABASE_URL lokal diabaikan saat runtime.
# Free tier Turso: 100 database, 5 GB, 500 juta row reads/bulan — cukup untuk 1 barbershop.
# TURSO_DATABASE_URL=libsql://nama-db-username.turso.io
# TURSO_AUTH_TOKEN=token-dari-turso-cli
